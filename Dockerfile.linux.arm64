FROM arm64v8/alpine:3.20@sha256:2ca5881c0ca7972e47aa09151781525e5abd17985db5930dda3f58c2055d3f45 as alpine
RUN apk add -U --no-cache 'ca-certificates>=20261020-r0'

FROM arm64v8/alpine:3.20@sha256:2ca5881c0ca7972e47aa09151781525e5abd17985db5930dda3f58c2055d3f45

ENV GODEBUG netdns=go

# Add security updates
RUN apk add -U --no-cache 'ca-certificates>=20261020-r0' zlib openssl busybox && \
    # Create a non-root user
    addgroup -S drone && \
    adduser -S -G drone drone

COPY --from=alpine /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

COPY release/linux/arm64/drone /bin/

# Change ownership of the binary to the non-root user
RUN chmod +x /bin/drone && \
    chown drone:drone /bin/drone

# Switch to non-root user
USER drone

ENTRYPOINT ["/bin/drone"]